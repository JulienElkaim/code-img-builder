# Copy to .env (git-ignored, never baked in the image).
# LITELLM_BASE_URL and LITELLM_API_KEY: set them here OR as Windows env vars (a Windows env var wins over .env).
DEV_DIR=C:/Users/YOUR_NAME/dev
LITELLM_BASE_URL=https://litellm.mycompany.com/v1
LITELLM_API_KEY=

# --- JFrog ---
# Docker repo to pull the base image from (node:24-bookworm-slim is appended)
BASE_REPO=mycompany.jfrog.io/docker-remote/library
# Docker repo where asteroid-code is published / pulled (asteroid-code:<tag> is appended)
PUBLISH_REPO=mycompany.jfrog.io/docker-local
# npm registry written in the image's .npmrc
NPM_REGISTRY=https://mycompany.jfrog.io/artifactory/api/npm/npm-remote/
